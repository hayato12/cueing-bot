*.xml
*.mp3
*.wav
*.aif
*.aiff
*.flac
*.m4a
ANLZ*.DAT
ANLZ*.EXT
ANLZ*.2EX
master.db

# Python
__pycache__/
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/
# 個人データの置き場（既定はリポジトリの外の ~/llm/cueing-bot/data/）を誤って中に作ったとき用
/data/
*.db
*.db-wal
*.db-shm
*.db.bak
